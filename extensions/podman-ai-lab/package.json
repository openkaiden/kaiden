{
  "name": "podman-ai-lab",
  "displayName": "Podman AI Lab",
  "description": "Register Podman AI Lab models to Kaiden.",
  "version": "0.5.0-next",
  "icon": "icon.png",
  "publisher": "kaiden",
  "license": "Apache-2.0",
  "engines": {
    "kaiden": "^0.0.1"
  },
  "main": "./dist/extension.js",
  "source": "./src/extension.ts",
  "contributes": {
    "configuration": {
      "title": "Podman AI Lab",
      "properties": {
        "podman-ai-lab.apiPort": {
          "type": "number",
          "scope": "DEFAULT",
          "default": 10434,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port of the Podman AI Lab API server. Must match the 'ai-lab.apiPort' preference of Podman AI Lab (random port mode is not supported)."
        }
      }
    }
  },
  "scripts": {
    "build": "vite build && node ./scripts/build.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "inversify": "^7.10.4",
    "ollama-ai-provider-v2": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openkaiden/api": "workspace:*",
    "adm-zip": "^0.5.16",
    "mkdirp": "^3.0.1",
    "msw": "^2.12.2",
    "vite": "^7.1.2",
    "vitest": "^4.0.10"
  }
}
