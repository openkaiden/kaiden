summary: Run the workspace provider Playwright project
test: bash ../scripts/workspace-provider.sh
# Keep below the Testing Farm timeout and the GitHub job timeout-minutes so a
# run that overshoots still returns a Testing Farm result instead of being
# killed by the outer GitHub job.
duration: 200m
require:
  - podman
